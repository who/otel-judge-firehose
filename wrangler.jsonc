{
  // Cloudflare Worker configuration for the packet firehose producer.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otel-judge-firehose",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // Workers AI binding for the chaos scenario's `llm` mode. The model runs
  // inside this Worker so no inference credential ever reaches the demo.
  // Optional at runtime: without it, `llm` falls back to the template path.
  "ai": {
    "binding": "AI"
  },
  // Non-secret configuration. See `src/config.ts` (`resolveConfig`) for how
  // these are validated, and `.dev.vars.example` for local overrides.
  //
  // JUDGE_INGEST_TOKEN is deliberately absent here: it is a secret and must be
  // set with `wrangler secret put JUDGE_INGEST_TOKEN`, never committed.
  "vars": {
    // Required. Absolute HTTPS URL of the otel-judge Worker ingress.
    // Placeholder value; override per deployment.
    "JUDGE_FIREHOSE_URL": "https://otel-judge.example.workers.dev",
    // Comma-separated origins allowed to call the emit API.
    "DEMO_ORIGIN_ALLOWLIST": "https://who.github.io"
  }
}
